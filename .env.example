# --- Database ---
# Any Postgres connection string works (Neon, Supabase, Vercel Postgres, Railway...).
# Free options: https://neon.tech or https://supabase.com
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- NextAuth ---
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Discord OAuth App ---
# Create at https://discord.com/developers/applications
# OAuth2 > Redirect URL must be: <your-domain>/api/auth/callback/discord
AUTH_DISCORD_ID="your-discord-client-id"
AUTH_DISCORD_SECRET="your-discord-client-secret"

# --- Chaos Discord membership verification ---
# Server-side only. The bot must be a member of this Discord server.
DISCORD_GUILD_ID="your-chaos-guild-id"
DISCORD_BOT_TOKEN="your-discord-bot-token"

# --- Bootstrap admin ---
# Your own Discord USER ID (enable Developer Mode in Discord, right-click your
# name, Copy User ID). This account is always treated as admin, even before
# anyone is added in the admin panel, so you can never lock yourself out.
OWNER_DISCORD_ID="your-discord-user-id"

# --- Discord notifications ---
# A webhook URL from the server channel you want submissions posted to.
# Server Settings > Integrations > Webhooks > New Webhook > Copy URL.
# This is just the default; admins can change it later from the admin panel.
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/xxxx/yyyy"
